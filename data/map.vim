" data/map.vim - 1836年の地球マップ定義
" template: ASCII 世界地図(200x37)。tools/gen_map.py が緯度経度の海岸線
"           ポリゴンから生成した data/map_ascii.vim を読み込む。
"           {TAG} は州プレースホルダ(描画時に州名ラベルへ置換される)。
"           ~ は海。
" states の row/col はローダが template から自動計算するので書かない。
" pop の単位は「万人」(1836年頃の概算)。
" name_en は英語版の表示名。地図上のラベルにもそのまま使うため、
" 州名は他州と重複しない短めの正式名称にする。

let g:vimtoria_data_map = {}

execute 'source' fnameescape(expand('<sfile>:p:h') . '/map_ascii.vim')

